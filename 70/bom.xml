    <component type="library" bom-ref="pkg:maven/network.ike.platform/ike-platform@70?type=pom">
      <publisher>IKE Network</publisher>
      <group>network.ike.platform</group>
      <name>ike-platform</name>
      <version>70</version>
      <description>Consumer-facing parent POM, BOM, and workspace management plugin
        for the IKE Network. External doc and code projects inherit
        from ike-parent (declared here); cross-repo workspace operations
        use ike-workspace-maven-plugin (ws:* goals). Consumes ike-docs
        as an external artifact — ike-parent declares ike-doc-maven-plugin
        with extensions=true, resolving from Nexus at project-load time.
        Split from the archived ike-pipeline; see IKE-Network/ike-issues#216.</description>
