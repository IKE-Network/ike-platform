<?xml version="1.0" encoding="UTF-8"?>
<!--
  IKE Network — Parent POM
  ═══════════════════════════

  The standard parent for all IKE Network projects. Inheriting this
  POM provides two things through a single <parent> declaration:

    1. Build conventions: Java 25 compiler configuration, ASM 9.9 for
       annotation processing, surefire/failsafe with JPMS add-opens,
       GPG signing with Bouncy Castle, platform classifier profiles,
       enforcer rules, and the AsciiDoc documentation pipeline (activated
       when src/docs/asciidoc exists). Inherited from the ike-platform
       reactor root.

    2. Dependency version management — centralized versions for IKE
       infrastructure artifacts (ike-docs, ike-tooling), AsciiDoc
       toolchain dependencies, and shared test dependencies (JUnit 5,
       AssertJ, Mockito). Declared inline using properties inherited
       from the root POM.

    3. Extension-true declarations for ike-doc-maven-plugin and
       ike-maven-plugin. These are LITERAL versions (not ${property})
       because Maven resolves extension plugin JARs at project-load
       time, before property interpolation.

  Usage (inheritance — recommended):

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>1</version>
    </parent>

  Dependency versions are declared inline (no BOM import) to avoid
  Maven 4's "BOM imports from within reactor" warning. Version
  properties are inherited from the root POM (single source of truth).
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-platform</artifactId>
    </parent>

    <artifactId>ike-parent</artifactId>
    <packaging>pom</packaging>

    <name>IKE Parent</name>
    <description>
        Standard parent POM for IKE Network projects. Inheriting this
        POM provides build conventions (Java 25 compiler, test harness,
        GPG signing, AsciiDoc documentation pipeline) from the
        ike-platform reactor root and centralized dependency version
        management declared inline. Declares ike-doc-maven-plugin
        (from network.ike.docs) with extensions=true to provide the
        ike-doc custom packaging type to external doc projects.
    </description>
    <url>https://ike.network/ike-platform/ike-parent/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <distributionManagement>
        <repository>
            <!-- Developers deploy releases to ike-staging. -->
            <!-- TeamCity verifies reproducibility then promotes to ike-releases. -->
            <id>ike-staging</id>
            <url>${deploy.staging.url}</url>
        </repository>
        <snapshotRepository>
            <id>ike-snapshots</id>
            <url>${deploy.snapshot.url}</url>
        </snapshotRepository>
        <!-- No <site> override here — ike-parent inherits the
             reactor root's version-prefixed deploy URL
             (ike-issues#302, #303). The previous override existed
             as a workaround for the per-module ${project.artifactId}
             evaluation bug, which is now fixed at the source. -->
    </distributionManagement>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- Dependency Management — centralized versions for the IKE         -->
    <!-- ecosystem. Version properties are inherited from the root POM.   -->
    <!-- External consumers inheriting this POM get build conventions     -->
    <!-- (from root) + dependency versions (from here).                   -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <!-- Top-level properties — visible to external consumers via         -->
    <!-- standard Maven inheritance. Java version + plugin versions       -->
    <!-- needed by the pluginManagement compiler/surefire/failsafe        -->
    <!-- configs below; without them external consumers wouldn't get      -->
    <!-- preview features enabled (see #280).                             -->
    <properties>
        <java.version>25</java.version>
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
        <!-- ASM in surefire/failsafe/compiler plugin realm — release that
             supports classfile major 69 (Java 25). See #282 (surefire/
             failsafe) and #283 (compiler). -->
        <asm.version>9.9.1</asm.version>
        <!-- Record-builder annotation processor — used across IKE Java
             modules. See #282. -->
        <record-builder-core.version>34</record-builder-core.version>
        <!-- Skip jacoco with -Dike.skip.jacoco=true. -->
        <ike.skip.jacoco>false</ike.skip.jacoco>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ── IKE Infrastructure Artifacts ───────────────────────── -->

            <!-- Claude instruction files (classified ZIP) -->
            <dependency>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-build-standards</artifactId>
                <version>${ike-tooling.version}</version>
                <classifier>claude</classifier>
                <type>zip</type>
            </dependency>

            <!-- Human-readable convention documents (classified ZIP) -->
            <dependency>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-build-standards</artifactId>
                <version>${ike-tooling.version}</version>
                <classifier>docs</classifier>
                <type>zip</type>
            </dependency>

            <!-- .asciidoctorconfig for IDE preview (classified ZIP) -->
            <dependency>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-build-standards</artifactId>
                <version>${ike-tooling.version}</version>
                <classifier>asciidoctorconfig</classifier>
                <type>zip</type>
            </dependency>

            <!-- Shared build config files (editorconfig, checkstyle, stignore) -->
            <dependency>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-build-standards</artifactId>
                <version>${ike-tooling.version}</version>
                <classifier>config</classifier>
                <type>zip</type>
            </dependency>

            <!-- Forest theme site.css + ike-logo.svg (classified ZIP) — see #318 -->
            <dependency>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-build-standards</artifactId>
                <version>${ike-tooling.version}</version>
                <classifier>site-theme</classifier>
                <type>zip</type>
            </dependency>

            <!-- Documentation resources: themes, assembly descriptors, configs
                 (external artifact — lives in ike-docs repo) -->
            <dependency>
                <groupId>network.ike.docs</groupId>
                <artifactId>ike-doc-resources</artifactId>
                <version>${ike-docs.version}</version>
            </dependency>

            <!-- Noto fonts for PDF generation (minimal subset) -->
            <dependency>
                <groupId>network.ike.docs</groupId>
                <artifactId>minimal-fonts</artifactId>
                <version>${ike-docs.version}</version>
                <type>zip</type>
            </dependency>

            <!-- DocBook XSL 1.79.2 + IKE FO customization layer -->
            <dependency>
                <groupId>network.ike.docs</groupId>
                <artifactId>docbook-xsl</artifactId>
                <version>${ike-docs.version}</version>
            </dependency>

            <!-- Koncept AsciiDoc extension -->
            <dependency>
                <groupId>network.ike.docs</groupId>
                <artifactId>koncept-asciidoc-extension</artifactId>
                <version>${ike-docs.version}</version>
            </dependency>

            <!-- ── AsciiDoc Toolchain ─────────────────────────────────── -->

            <dependency>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctorj</artifactId>
                <version>${asciidoctorj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctorj-pdf</artifactId>
                <version>${asciidoctorj-pdf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctorj-diagram</artifactId>
                <version>${asciidoctorj-diagram.version}</version>
            </dependency>

            <!-- ── Test Dependencies ──────────────────────────────────── -->

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- Dependencies — inherited by external projects.                   -->
    <!-- ike-build-standards (from ike-tooling) is unpacked at validate     -->
    <!-- phase by the inherited unpack-claude-standards execution.          -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <dependencies>
        <dependency>
            <groupId>network.ike.tooling</groupId>
            <artifactId>ike-build-standards</artifactId>
            <classifier>claude</classifier>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>network.ike.tooling</groupId>
            <artifactId>ike-build-standards</artifactId>
            <classifier>config</classifier>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin><artifactId>maven-clean-plugin</artifactId><version>3.4.0</version></plugin>
                <plugin><artifactId>maven-install-plugin</artifactId><version>3.1.3</version></plugin>
                <plugin><artifactId>maven-deploy-plugin</artifactId><version>3.1.3</version></plugin>

                <!-- Java 25 with preview features. External consumers       -->
                <!-- inheriting this POM (e.g. komet-desktop, doc-example)   -->
                <!-- need this here — the equivalent config in the           -->
                <!-- ike-platform reactor root only reaches modules that     -->
                <!-- parent to the reactor, not external ike-parent          -->
                <!-- consumers. See #280.                                    -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <!-- ASM in compiler plugin realm — symmetric with the   -->
                    <!-- surefire/failsafe injection in #282. Annotation     -->
                    <!-- processors (or maven-compiler-plugin internals)     -->
                    <!-- that read existing class files need a recent ASM    -->
                    <!-- to handle Java 25 class file major 69. See #283.    -->
                    <dependencies>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-tree</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-commons</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-util</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <release>${java.version}</release>
                        <compilerArgs>
                            <arg>-parameters</arg>
                            <arg>--enable-preview</arg>
                        </compilerArgs>
                        <showWarnings>true</showWarnings>
                        <showDeprecation>true</showDeprecation>
                        <!-- Record-builder annotation processor — used      -->
                        <!-- across IKE Java modules. Promoted to ike-parent -->
                        <!-- so each consumer doesn't need to re-declare.    -->
                        <!-- See #282.                                       -->
                        <annotationProcessorPaths>
                            <annotationProcessorPath>
                                <groupId>io.soabase.record-builder</groupId>
                                <artifactId>record-builder-processor</artifactId>
                                <version>${record-builder-core.version}</version>
                            </annotationProcessorPath>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- Surefire/Failsafe argLines — preview features must be   -->
                <!-- enabled at test runtime to load preview-marked classes  -->
                <!-- (e.g. anything from tinkar-entity, komet-*).            -->
                <!-- @{argLine} preserves any agent argLine (jacoco etc.).   -->
                <!-- ASM dependencies in plugin realm — surefire 3.5.x's     -->
                <!-- bundled ASM doesn't reliably parse Java 25 class files  -->
                <!-- (major 69). Promoted from komet-desktop. See #282.      -->
                <!-- forkCount=1, reuseForks=false isolates each test JVM,   -->
                <!-- avoiding cross-test JVM state and giving stable timings -->
                <!-- under preview-features.                                  -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-tree</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-commons</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <useModulePath>false</useModulePath>
                        <forkCount>1</forkCount>
                        <reuseForks>false</reuseForks>
                        <argLine>
                            @{argLine}
                            --enable-preview
                            --enable-native-access=ALL-UNNAMED
                            --add-opens java.base/java.lang=ALL-UNNAMED
                            --add-opens java.base/java.util=ALL-UNNAMED
                            --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                            --add-opens java.base/java.io=ALL-UNNAMED
                        </argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-tree</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm-commons</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <useModulePath>false</useModulePath>
                        <forkCount>1</forkCount>
                        <reuseForks>false</reuseForks>
                        <argLine>
                            @{failsafeArgLine}
                            --enable-preview
                            --enable-native-access=ALL-UNNAMED
                            --add-opens java.base/java.lang=ALL-UNNAMED
                            --add-opens java.base/java.util=ALL-UNNAMED
                            --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                            --add-opens java.base/java.io=ALL-UNNAMED
                        </argLine>
                    </configuration>
                </plugin>

                <!-- maven-jar-plugin — manifest entries used by             -->
                <!-- WorkspaceReport.pluginVersion to discover plugin        -->
                <!-- version at runtime (see #208). Promoted from reactor    -->
                <!-- root so external consumers get it. See #282.            -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>

                <!-- maven-source-plugin — auto-attach sources jar to every  -->
                <!-- artifact. Promoted from reactor root so external        -->
                <!-- consumers publish sources without re-declaring. #282.   -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- jacoco — code coverage. prepare-agent (surefire) and    -->
                <!-- prepare-agent-integration (failsafe) symmetrically set  -->
                <!-- @{argLine} and @{failsafeArgLine}, which the parent     -->
                <!-- argLine configs above reference. Skip with              -->
                <!-- -Dike.skip.jacoco=true. See #282.                       -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <configuration>
                        <skip>${ike.skip.jacoco}</skip>
                        <formats>
                            <format>HTML</format>
                            <format>XML</format>
                            <format>CSV</format>
                        </formats>
                    </configuration>
                    <executions>
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals><goal>prepare-agent</goal></goals>
                        </execution>
                        <execution>
                            <id>jacoco-prepare-agent-integration</id>
                            <goals><goal>prepare-agent-integration</goal></goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>verify</phase>
                            <goals><goal>report</goal></goals>
                        </execution>
                        <execution>
                            <id>jacoco-report-integration</id>
                            <phase>verify</phase>
                            <goals><goal>report-integration</goal></goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <doclint>${ike.javadoc.doclint}</doclint>
                        <failOnWarnings>${ike.javadoc.failOnWarnings}</failOnWarnings>
                        <source>${java.version}</source>
                        <additionalOptions>
                            <additionalOption>--enable-preview</additionalOption>
                        </additionalOptions>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-artifact-plugin</artifactId>
                    <version>3.5.2</version>
                    <executions>
                        <execution>
                            <id>buildinfo</id>
                            <goals><goal>buildinfo</goal></goals>
                            <phase>verify</phase>
                        </execution>
                    </executions>
                </plugin>

                <!-- Maven Dependency Plugin — unpack-site-theme execution
                     config (#318, #330). External consumers inheriting
                     this POM (ike-lab-documents, doc-example, example-project)
                     activate this execution via the site-resources profile.
                     The equivalent config previously lived only in the
                     ike-platform reactor root pluginManagement, which
                     external consumers do not inherit; symptom: every
                     external consumer's site rendered with the default
                     Sentry skin placeholder instead of the canonical
                     Forest theme. Mirrors the same fix pattern as the
                     maven-compiler-plugin lift in #280. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>unpack-site-theme</id>
                            <phase>pre-site</phase>
                            <goals><goal>unpack-dependencies</goal></goals>
                            <configuration>
                                <includeArtifactIds>ike-build-standards</includeArtifactIds>
                                <includeClassifiers>site-theme</includeClassifiers>
                                <includeTypes>zip</includeTypes>
                                <outputDirectory>${project.build.directory}/generated-site/resources</outputDirectory>
                                <overWriteReleases>true</overWriteReleases>
                                <overWriteSnapshots>true</overWriteSnapshots>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- ── maven-resources-plugin ──────────────────────────────
                     Hosts the copy-bom-to-site execution (#333) so the
                     CycloneDX SBOM produced at package phase is reachable
                     from the rendered Maven Site at site:site time. The
                     resources plugin runs once at pre-site, copying
                     target/bom.{json,xml} into target/site/ where Maven
                     Site picks them up alongside the rendered HTML. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>copy-bom-to-site</id>
                            <phase>pre-site</phase>
                            <goals><goal>copy-resources</goal></goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/site</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>${project.build.directory}</directory>
                                        <includes>
                                            <include>bom.json</include>
                                            <include>bom.xml</include>
                                        </includes>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- ── cyclonedx-maven-plugin ──────────────────────────────
                     Generates a CycloneDX Software Bill of Materials at
                     package phase: target/bom.json + target/bom.xml.
                     Auto-attaches them as Maven artifacts with classifier
                     `cyclonedx`, so consumers can pull the SBOM through
                     Nexus / Maven Central as well as from the published
                     site (see copy-bom-to-site above).

                     Licenses are normalized to SPDX expressions
                     (`Apache-2.0`, `EPL-2.0 OR GPL-2.0-only`, …) so the
                     output is ingestible by Dependency-Track, Trivy,
                     Snyk, and GitHub's dependency graph without the
                     POM-string noise that plagues licenses.html. See
                     ike-issues#333. -->
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>2.9.0</version>
                    <executions>
                        <execution>
                            <id>make-bom</id>
                            <phase>package</phase>
                            <goals><goal>makeBom</goal></goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Activate standard unpacks for all inheriting projects.
             unpack-dependencies resolves from reactor; no-op if
             the dependency is absent. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-claude-standards</id>
                        <!-- inherits config from pluginManagement -->
                    </execution>
                    <execution>
                        <id>unpack-build-tools</id>
                        <!-- inherits config from pluginManagement -->
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo — code coverage for all inheriting projects.
                 Configuration is inherited from root POM pluginManagement.
                 Skip with -Dike.skip.jacoco=true. Reports in target/site/jacoco/ -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <!-- SBOM (#333) — CycloneDX produces target/bom.{json,xml}
                 at package phase; maven-resources-plugin copies them
                 into target/site/ at pre-site so they're reachable
                 from the published Maven Site. Configuration in
                 pluginManagement above. -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-bom-to-site</id>
                        <!-- inherits config from pluginManagement -->
                    </execution>
                </executions>
            </plugin>

            <!-- IKE Maven Plugin — release orchestration, BOM generation,
                 site deploy, AsciiDoc utilities. External (from
                 ike-tooling). Regular managed plugin — version
                 resolves via property indirection like any other.
                 Earlier revisions declared this with
                 <extensions>true</extensions> at a literal version
                 to register the now-retired ike-doc packaging type;
                 see ike-issues#321 for the design rationale. -->
            <plugin>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-maven-plugin</artifactId>
                <version>${ike-tooling.version}</version>
            </plugin>

            <!-- IKE Doc Maven Plugin — idoc:* render goals
                 (AsciiDoc, multi-renderer PDF wrappers). External
                 (from ike-docs). Regular managed plugin — version
                 resolves via property indirection. Earlier revisions
                 declared this with <extensions>true</extensions> at
                 a literal version to register the
                 <packaging>ike-doc</packaging> custom type via
                 META-INF/plexus/components.xml; that custom packaging
                 was retired in ike-issues#321 in favor of a
                 classifier-canonical doc shape
                 (<classifier>adoc</classifier><type>zip</type>). -->
            <plugin>
                <groupId>network.ike.docs</groupId>
                <artifactId>ike-doc-maven-plugin</artifactId>
                <version>${ike-docs.version}</version>
            </plugin>

            <!-- IKE Workspace Maven Plugin — workspace management goals
                 (ws:*). Co-released with ike-parent in this reactor.
                 Inheriting projects get ws: goals at the matching version. -->
            <plugin>
                <groupId>network.ike.platform</groupId>
                <artifactId>ike-workspace-maven-plugin</artifactId>
                <version>${project.version}</version>
            </plugin>
        </plugins>
    </build>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- Profiles                                                        -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <profiles>
        <!-- ── doc-pipeline ─────────────────────────────────────────── -->
        <!-- Activated when src/docs/asciidoc exists. Provides doc       -->
        <!-- artifact dependencies and their unpack executions.          -->
        <!-- The rest of the doc pipeline (asciidoctor, resources,       -->
        <!-- assembly) is inherited from the root POM’s doc-pipeline     -->
        <!-- profile.                                                    -->
        <profile>
            <id>doc-pipeline-deps</id>
            <activation>
                <file><exists>src/docs/asciidoc</exists></file>
            </activation>

            <dependencies>
                <dependency>
                    <groupId>network.ike.tooling</groupId>
                    <artifactId>ike-build-standards</artifactId>
                    <classifier>asciidoctorconfig</classifier>
                    <type>zip</type>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>network.ike.docs</groupId>
                    <artifactId>ike-doc-resources</artifactId>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>network.ike.docs</groupId>
                    <artifactId>minimal-fonts</artifactId>
                    <type>zip</type>
                </dependency>
                <dependency>
                    <groupId>network.ike.docs</groupId>
                    <artifactId>docbook-xsl</artifactId>
                    <scope>provided</scope>
                </dependency>
            </dependencies>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-asciidoctorconfig</id>
                                <!-- inherits config from pluginManagement -->
                            </execution>
                            <execution>
                                <id>unpack-doc-resources</id>
                                <!-- inherits config from pluginManagement -->
                            </execution>
                            <execution>
                                <id>unpack-fonts</id>
                                <!-- inherits config from pluginManagement -->
                            </execution>
                            <execution>
                                <id>unpack-docbook-xsl</id>
                                <!-- inherits config from pluginManagement -->
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- ── site-resources ───────────────────────────────────────── -->
        <!-- Activated when src/site exists. Pulls the canonical Forest -->
        <!-- theme site.css + ike-logo.svg from ike-build-standards     -->
        <!-- (classifier=site-theme) and unpacks them at pre-site into  -->
        <!-- target/generated-site/resources/, which Maven Site merges  -->
        <!-- into target/site at site:site time. See #318.              -->
        <profile>
            <id>site-resources</id>
            <activation>
                <file><exists>src/site</exists></file>
            </activation>

            <dependencies>
                <dependency>
                    <groupId>network.ike.tooling</groupId>
                    <artifactId>ike-build-standards</artifactId>
                    <classifier>site-theme</classifier>
                    <type>zip</type>
                    <scope>provided</scope>
                </dependency>
            </dependencies>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-site-theme</id>
                                <!-- inherits config from pluginManagement -->
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ── skip-javadoc-for-pom ─────────────────────────────────── -->
        <!-- POM-packaging modules have no Java source. Skip javadoc     -->
        <!-- and source jar to avoid "fake javadoc directory" warnings.   -->
        <profile>
            <id>skip-javadoc-for-pom</id>
            <activation>
                <packaging>pom</packaging>
            </activation>
            <properties>
                <maven.javadoc.skip>true</maven.javadoc.skip>
                <maven.source.skip>true</maven.source.skip>
            </properties>
        </profile>
    </profiles>
</project>
