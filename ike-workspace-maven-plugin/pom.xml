<?xml version="1.0" encoding="UTF-8"?>
<!--
  IKE Network — Workspace Maven Plugin
  ═══════════════════════════════════════

  Cross-platform Maven plugin for multi-repository workspace management:
  initialization, verification, feature branching, release orchestration,
  and checkpoint creation. All logic is implemented in Java.

  Build:    mvn install
  Test:     mvn ws:help -pl ike-workspace-maven-plugin
  Artifact: network.ike.platform:ike-workspace-maven-plugin:<version>
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-platform</artifactId>
    </parent>

    <artifactId>ike-workspace-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>IKE Workspace Maven Plugin</name>
    <description>
        Cross-platform Maven plugin for multi-repository workspace management:
        initialization, verification, feature branching, release orchestration,
        and checkpoint creation.
    </description>
    <url>https://ike.network/ike-platform/ike-workspace-maven-plugin/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <distributionManagement>
        <repository>
            <id>ike-staging</id>
            <url>${deploy.staging.url}</url>
        </repository>
        <snapshotRepository>
            <id>ike-snapshots</id>
            <url>${deploy.snapshot.url}</url>
        </snapshotRepository>
        <!-- <site> URL for site:stage relative-path computation.
             Actual content publish goes through
             publishProjectSiteToGhPages (#304: scpexe deploy retired). -->
        <site>
            <id>ike-site</id>
            <url>https://ike.network/ike-platform/${project.artifactId}/</url>
        </site>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.deploy.skip>false</maven.deploy.skip>
        <maven.install.skip>false</maven.install.skip>
        <!-- Maven 4 API — provided by the Maven 4.0.0-rc-5 runtime -->
        <maven-api.version>4.0.0-rc-5</maven-api.version>
        <maven-plugin-plugin.version>4.0.0-beta-2</maven-plugin-plugin.version>
        <!-- Exclude container tests by default (same as ike-tooling convention) -->
        <surefire.excludedGroups>container</surefire.excludedGroups>
        <!-- The lease core (protocol + materializer, IKE-Network/ike-issues#1067):
             WorkingSetLease calls it in-process, which is what retired the
             goal-to-$HOME-script coupling (#1005's ws: half). -->
        <network.ike__GA__ike-lease-core__VERSION>5</network.ike__GA__ike-lease-core__VERSION>
        <network.ike__GA__ike-lease-core__ALIAS>ike-lease-core.version</network.ike__GA__ike-lease-core__ALIAS>
    </properties>

    <dependencies>
        <!-- The working-set lease core, consumed in-process (#1005, #1067). -->
        <dependency>
            <groupId>network.ike</groupId>
            <artifactId>ike-lease-core</artifactId>
            <version>${network.ike__GA__ike-lease-core__VERSION}</version>
        </dependency>
        <!-- Workspace model library (includes ReleaseSupport, ReleaseNotesSupport) -->
        <dependency>
            <groupId>network.ike.tooling</groupId>
            <artifactId>ike-workspace-model</artifactId>
            <version>${network.ike.tooling__GA__ike-tooling__VERSION}</version>
        </dependency>
        <!-- Plugin support library — provides VersionUpgradePlanBuilder,
             VersionUpgradePlanApplier, SessionCandidateVersionResolver and
             AbstractGoalMojo helpers used by the workspace-scope versions
             upgrade goals (#230). -->
        <dependency>
            <groupId>network.ike.tooling</groupId>
            <artifactId>ike-maven-plugin-support</artifactId>
            <version>${network.ike.tooling__GA__ike-tooling__VERSION}</version>
        </dependency>
        <!-- Claude instruction files (unpacked at validate phase) -->
        <dependency>
            <groupId>network.ike.tooling</groupId>
            <artifactId>ike-build-standards</artifactId>
            <version>${network.ike.tooling__GA__ike-tooling__VERSION}</version>
            <classifier>claude</classifier>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
        <!-- Maven 4 plugin API (native) -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-api-core</artifactId>
            <version>${maven-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-api-di</artifactId>
            <version>${maven-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-api-plugin</artifactId>
            <version>${maven-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-api-model</artifactId>
            <version>${maven-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- maven-support (MavenStaxReader) comes transitively from
             ike-workspace-model as compile scope — Maven 4 plugin realms
             don't auto-import it, so it must be bundled. -->

        <!-- OpenRewrite XML comes transitively via ike-workspace-model
             (PomRewriter relocated there in IKE-Network/ike-issues#348). -->

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <plugin><artifactId>maven-clean-plugin</artifactId><version>3.4.0</version></plugin>
                <plugin><artifactId>maven-install-plugin</artifactId><version>3.1.3</version></plugin>
                <plugin><artifactId>maven-deploy-plugin</artifactId><version>3.1.3</version></plugin>
                <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version></plugin>
                <plugin><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
                <plugin><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <redirectTestOutputToFile>true</redirectTestOutputToFile>
                        <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                        <!-- Hermetic git: these integration tests shell out
                             to real `git` in throwaway sandbox repos. Point the
                             forked test JVM (and the git children the mojos
                             spawn) at a minimal, checked-in global config and
                             disable system config, so the host's ~/.gitconfig
                             can never affect the build: no foreign
                             core.hooksPath with failing hooks, no commit
                             signing, no global excludesFile. hermetic.gitconfig
                             supplies a committer identity so goal preflights
                             that require user.email (e.g. ws:switch, read at the
                             non-repo workspace root) pass. The per-repo config +
                             .gitignore in TestWorkspaceHelper are
                             belt-and-suspenders. IKE-Network/ike-issues#560. -->
                        <environmentVariables>
                            <GIT_CONFIG_GLOBAL>${project.basedir}/src/test/resources/hermetic.gitconfig</GIT_CONFIG_GLOBAL>
                            <GIT_CONFIG_NOSYSTEM>1</GIT_CONFIG_NOSYSTEM>
                        </environmentVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven-plugin-plugin.version}</version>
                <configuration>
                    <requiredJavaVersion>${java.version}</requiredJavaVersion>
                    <goalPrefix>ws</goalPrefix>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>${asm.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-tree</artifactId>
                        <version>${asm.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>${asm.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
