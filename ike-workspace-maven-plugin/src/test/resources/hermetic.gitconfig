# Minimal, host-independent git config for ike-workspace-maven-plugin tests.
#
# GIT_CONFIG_GLOBAL points here (see the maven-surefire-plugin
# <environmentVariables> in this module's pom.xml), and GIT_CONFIG_NOSYSTEM
# disables system config, so the forked test JVM — and the real `git` the
# mojos shell out to in their sandbox repos — never read the developer's or
# CI agent's ~/.gitconfig: no foreign core.hooksPath with failing hooks, no
# commit signing, no global core.excludesFile. A committer identity is
# provided here so goal preflights that require user.email (e.g. ws:switch,
# which reads it at the non-repo workspace root) pass without depending on the
# host. Local VCS state (.ike/vcs-state) is ignored per-repo via the sandbox
# .gitignore that TestWorkspaceHelper writes, mirroring real IKE repos.
#
# See IKE-Network/ike-issues#560.
[user]
	email = ike-test@example.com
	name = IKE Test
[commit]
	gpgsign = false
[tag]
	gpgsign = false
[init]
	defaultBranch = main
